rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User certificate storage path: certificates/{userId}/{fileName}
    match /certificates/{userId}/{allPaths=**} {
      // Owner can upload, modify and delete their own files
      // Restrict uploads to 10MB and valid image/pdf MIME types
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      
      // Reading certificate files is allowed for owner, or if public URL is granted
      allow read: if request.auth != null && request.auth.uid == userId;
      // Public reading can be enabled via download tokens generated on upload
    }

    // User profile avatars: avatars/{userId}/{fileName}
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
